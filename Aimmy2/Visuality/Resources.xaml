<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Sidebar UI kit (flat dark cards, pill switches, accent = ThemeColor) -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UIHeadFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UIMonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="UI.Text" Color="#E8EEF1" />
    <SolidColorBrush x:Key="UI.TextSoft" Color="#C3CDD3" />
    <SolidColorBrush x:Key="UI.TextDim" Color="#8D99A3" />
    <SolidColorBrush x:Key="UI.NavText" Color="#9AA6AE" />
    <SolidColorBrush x:Key="UI.Line" Color="#1E262B" />
    <SolidColorBrush x:Key="UI.Box" Color="#2A343A" />
    <SolidColorBrush x:Key="UI.Bg" Color="#0B0E10" />
    <SolidColorBrush x:Key="UI.Panel" Color="#0F1316" />
    <SolidColorBrush x:Key="UI.CardBg" Color="#12171A" />
    <SolidColorBrush x:Key="UI.CardBorder" Color="#1E262B" />
    <SolidColorBrush x:Key="UI.Hover" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="UI.KeyBg" Color="#1A2125" />

    <!-- Whales logo: a whale tail inside a crosshair, on a 24x24 grid. Draw Logo.Lines as a
         1.8-wide round-capped stroke and fill Logo.Tail, both in the same brush, inside a Viewbox. -->
    <Geometry x:Key="Logo.Lines">M3.8,12 A8.2,8.2 0 1 1 20.2,12 A8.2,8.2 0 1 1 3.8,12 Z M12,1.8 L12,5 M12,19 L12,22.2 M1.8,12 L5,12 M19,12 L22.2,12</Geometry>
    <Geometry x:Key="Logo.Tail">M12,17 C11.5,15 11.3,13.3 11.4,12 C10,12.2 8.2,11.6 7,9.9 C6.7,9.4 6.9,8.9 7.5,9.1 C8.9,9.5 10.3,9.7 11.5,9.1 C11.7,9 11.9,8.7 12,8.5 C12.1,8.7 12.3,9 12.5,9.1 C13.7,9.7 15.1,9.5 16.5,9.1 C17.1,8.9 17.3,9.4 17,9.9 C15.8,11.6 14,12.2 12.6,12 C12.7,13.3 12.5,15 12,17 Z</Geometry>

    <!-- Kept for older windows that still reference it -->
    <DrawingBrush x:Key="UI.Hatch"
                  TileMode="Tile"
                  Viewport="0,0,14,14"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,14 L14,0">
                <GeometryDrawing.Pen>
                    <Pen Brush="#06FFFFFF" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Row label (left side of every option row) -->
    <Style x:Key="UI.RowLabel" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
        <Setter Property="Padding" Value="14,0,10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- One-line explanation under a row label -->
    <Style x:Key="UI.RowDesc" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="14,2,10,0" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!-- Row value (right side text: slider value, key name, ...) -->
    <Style x:Key="UI.RowValue" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="Padding" Value="10,0,14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Soft hover background on option rows -->
    <Style x:Key="UI.RowHighlight" TargetType="{x:Type Border}">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource UI.Hover}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- No longer drawn: rows highlight with a soft background instead -->
    <Style x:Key="UI.RowAccent" TargetType="{x:Type Rectangle}">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Invisible full-row click catcher -->
    <Style x:Key="UI.RowReader" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded icon button (slider -/+, browse, ...) -->
    <Style x:Key="UI.SquareButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource UI.TextSoft}" />
        <Setter Property="Background" Value="{StaticResource UI.KeyBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource UI.Box}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Key cap (bound key names) -->
    <Style x:Key="UI.KeyCap" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource UI.KeyBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource UI.Box}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="UI.KeyCapText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Kept for older controls -->
    <Style x:Key="UI.TabButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Flat window caption button -->
    <Style x:Key="UI.CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card container -->
    <Style x:Key="UI.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource UI.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource UI.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="UI.CardTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIHeadFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
    </Style>
    <Style x:Key="UI.CardSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="UI.PageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIHeadFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
    </Style>
    <Style x:Key="UI.Small" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Header status chip -->
    <Style x:Key="UI.Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource UI.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource UI.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="UI.ChipLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style x:Key="UI.ChipValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Sidebar navigation item -->
    <Style x:Key="UI.NavButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource UI.NavText}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="12,10">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource UI.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeColorTransparent}" />
                            <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="UI.NavIcon" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource ThemeColor}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Buttons -->
    <Style x:Key="UI.PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#0B0E10" />
        <Setter Property="Background" Value="{DynamicResource ThemeColor}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="UI.GhostButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
        <Setter Property="Background" Value="{StaticResource UI.KeyBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource UI.Box}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!-- TabControl Style with accent underlines -->
    <Style x:Key="ModelsTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="ModelsTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                        <Border x:Name="mainBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Margin="0,0,0,0">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              Focusable="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="#55FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="mainBorder" Property="BorderBrush" Value="{DynamicResource ThemeColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Tooltip Style - Theme Integrated -->
    <Style x:Key="Tooltip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#FF12171A"/>
        <Setter Property="Foreground" Value="#FFE8EEF1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HorizontalOffset" Value="12"/>
        <Setter Property="VerticalOffset" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#2A343A">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              ShadowDepth="4"
                                              Opacity="0.5"
                                              Color="Black"/>
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   TextWrapping="Wrap"
                                   MaxWidth="280"
                                   Margin="12,9,12,9"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
