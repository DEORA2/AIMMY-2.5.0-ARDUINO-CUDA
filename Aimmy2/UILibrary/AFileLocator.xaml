<UserControl x:Class="UILibrary.AFileLocator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="76">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Grid.RowSpan="2" Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="DropdownTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Prediction Method" />

        <Grid Grid.Row="1" Margin="22,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileLocationTextbox"
                     BorderBrush="{StaticResource UI.Line}"
                     Foreground="{StaticResource UI.TextDim}"
                     BorderThickness="0,0,0,1"
                     TextWrapping="NoWrap"
                     Text=""
                     Tag="No File Located"
                     FontFamily="{StaticResource UIFont}"
                     FontSize="13"
                     Padding="2,0"
                     Style="{DynamicResource placeHolder}"
                     Background="{x:Null}"
                     Height="26"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />
            <Button x:Name="OpenFileB"
                    Grid.Column="1"
                    Style="{StaticResource UI.SquareButton}"
                    Content="&#xE838;"
                    FontSize="12"
                    Width="26"
                    Height="26"
                    Margin="8,0,0,0"
                    Click="OpenFileB_Click" />
        </Grid>
    </Grid>
</UserControl>
