<UserControl x:Class="Whales2.UILibrary.AToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">
    <Grid MinHeight="48">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <StackPanel VerticalAlignment="Center" Margin="0,9,64,9">
            <Label x:Name="ToggleTitle"
                   Style="{StaticResource UI.RowLabel}"
                   Content="Toggle" />
            <TextBlock x:Name="RowDescription"
                       Style="{StaticResource UI.RowDesc}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Pill switch: knob slides right and the track fills with the theme colour when on -->
        <Border x:Name="SwitchBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="40"
                Height="22"
                CornerRadius="11"
                Margin="0,0,14,0"
                Padding="3"
                Background="#2A343A">
            <Border x:Name="SwitchMoving"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    HorizontalAlignment="Left"
                    Background="#C3CDD3">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KnobOffset" />
                </Border.RenderTransform>
            </Border>
        </Border>

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
