<UserControl x:Class="Whales2.UILibrary.AToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="46">
    <Grid Height="46">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="ToggleTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Aim only when Trigger Button is held"
               Margin="0,0,50,0" />

        <!-- Square checkbox: outlined when off, filled inner square when on -->
        <Border x:Name="SwitchBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="22"
                Height="22"
                Margin="0,0,16,0"
                Background="#33000000"
                BorderBrush="{StaticResource UI.Box}"
                BorderThickness="2">
            <Border x:Name="SwitchMoving"
                    Width="10"
                    Height="10"
                    Background="{DynamicResource ThemeColor}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0" />
                </Border.RenderTransform>
            </Border>
        </Border>

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
