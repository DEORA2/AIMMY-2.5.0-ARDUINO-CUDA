<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             x:Class="Whales2.UILibrary.ATitle"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="44">
    <!-- Section header: accent tick, condensed caps title, hairline rule, collapse button -->
    <Grid Height="44" Margin="0,6,0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Rectangle Width="3"
                   Height="16"
                   Margin="8,0,0,0"
                   Fill="{DynamicResource ThemeColor}"
                   VerticalAlignment="Center">
            <Rectangle.RenderTransform>
                <SkewTransform AngleX="-14" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Label x:Name="LabelTitle"
               Grid.Column="1"
               Padding="10,0,12,0"
               FontFamily="{StaticResource UIFont}"
               Content="Title"
               Foreground="{DynamicResource ThemeColor}"
               VerticalContentAlignment="Center"
               FontSize="13"
               FontWeight="SemiBold" />

        <Rectangle Grid.Column="2"
                   Height="1"
                   Fill="{StaticResource UI.Line}"
                   VerticalAlignment="Center" />

        <Button x:Name="Minimize"
                Grid.Column="3"
                Style="{StaticResource UI.CaptionButton}"
                Content="&#xE921;"
                Width="30"
                Height="26"
                Margin="6,0,4,0"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
