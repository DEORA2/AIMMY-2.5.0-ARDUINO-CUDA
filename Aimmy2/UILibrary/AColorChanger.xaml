<UserControl x:Class="Whales2.UILibrary.AColorChanger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="46">
    <Grid Height="46">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="ColorChangerTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Change Aim Keybind"
               Margin="0,0,60,0" />

        <!-- Color swatch framed like the checkbox -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="22"
                Height="22"
                Margin="0,0,16,0"
                BorderBrush="{StaticResource UI.Box}"
                BorderThickness="2"
                Padding="2">
            <Border x:Name="ColorChangingBorder"
                    Background="Red" />
        </Border>

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
