<UserControl x:Class="Whales2.UILibrary.ASlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Grid.RowSpan="3" Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="SliderTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Slider"
               HorizontalAlignment="Left"
               Margin="0,10,110,0" />
        <Label x:Name="AdjustNotifier"
               Style="{StaticResource UI.RowValue}"
               Content=""
               HorizontalAlignment="Right"
               Margin="0,10,0,0"
               Foreground="{DynamicResource ThemeColor}" />

        <TextBlock x:Name="RowDescription"
                   Grid.Row="1"
                   Style="{StaticResource UI.RowDesc}"
                   Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="14,6,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SubtractOne"
                    Style="{StaticResource UI.SquareButton}"
                    Content="&#xE949;"
                    Width="22"
                    Height="22" />
            <Slider x:Name="Slider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ThemeColor}"
                    IsSnapToTickEnabled="True"
                    Value="2"
                    TickFrequency="0.01" />
            <Button x:Name="AddOne"
                    Grid.Column="2"
                    Style="{StaticResource UI.SquareButton}"
                    Content="&#xE948;"
                    Width="22"
                    Height="22" />
        </Grid>
    </Grid>
</UserControl>
