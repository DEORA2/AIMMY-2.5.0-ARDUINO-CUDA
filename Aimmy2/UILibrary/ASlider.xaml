<UserControl x:Class="Whales2.UILibrary.ASlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="68">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Grid.RowSpan="2" Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="SliderTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Mouse Sensitivity"
               HorizontalAlignment="Left"
               Margin="0,0,110,0" />
        <Label x:Name="AdjustNotifier"
               Style="{StaticResource UI.RowValue}"
               Content="0.95 Sensitivity"
               HorizontalAlignment="Right"
               Foreground="{DynamicResource ThemeColor}" />

        <Grid Grid.Row="1" Margin="22,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SubtractOne"
                    Style="{StaticResource UI.SquareButton}"
                    Content="&#xE949;"
                    Width="20"
                    Height="20" />
            <Slider x:Name="Slider"
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ThemeColor}"
                    IsSnapToTickEnabled="True"
                    Value="2"
                    TickFrequency="0.01" />
            <Button x:Name="AddOne"
                    Grid.Column="2"
                    Style="{StaticResource UI.SquareButton}"
                    Content="&#xE948;"
                    Width="20"
                    Height="20" />
        </Grid>
    </Grid>
</UserControl>
