<UserControl x:Class="Whales2.UILibrary.AKeyChanger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380">
    <Grid MinHeight="48">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <StackPanel VerticalAlignment="Center" Margin="0,9,120,9">
            <Label x:Name="KeyChangerTitle"
                   Style="{StaticResource UI.RowLabel}"
                   Content="Keybind" />
            <TextBlock x:Name="RowDescription"
                       Style="{StaticResource UI.RowDesc}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Key cap showing the bound key; click the row to rebind -->
        <Border HorizontalAlignment="Right"
                Margin="0,0,14,0"
                Style="{StaticResource UI.KeyCap}"
                Height="26"
                MinWidth="40">
            <Label x:Name="KeyNotifier"
                   FontFamily="{StaticResource UIMonoFont}"
                   Content="Right"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   Padding="2,0"
                   Foreground="{StaticResource UI.Text}" />
        </Border>

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
