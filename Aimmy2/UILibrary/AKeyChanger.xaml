<UserControl x:Class="Whales2.UILibrary.AKeyChanger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="46">
    <Grid Height="46">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="KeyChangerTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Change Aim Keybind"
               Margin="0,0,96,0" />

        <!-- Key cap showing the bound key -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                MinWidth="34"
                Height="24"
                Background="#C8D2CBCE">
            <Label x:Name="KeyNotifier"
                   FontFamily="{StaticResource UIFont}"
                   Content="Right"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   Padding="8,0"
                   Foreground="#1A1416" />
        </Border>

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
