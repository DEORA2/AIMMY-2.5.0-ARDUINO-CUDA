<UserControl x:Class="UILibrary.ADropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="46">
    <!-- Title on the left, current choice right-aligned like a value -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="110" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="DropdownTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Prediction Method" />

        <ComboBox x:Name="DropdownBox"
                  Grid.Column="1"
                  Height="30"
                  Margin="8,0,14,0"
                  MaxWidth="210"
                  VerticalAlignment="Center"
                  Foreground="{StaticResource UI.Text}"
                  BorderBrush="{StaticResource UI.Line}"
                  BorderThickness="0,0,0,1"
                  Padding="6,0,4,0"
                  Background="{x:Null}"
                  HorizontalContentAlignment="Right"
                  SelectedIndex="0"
                  FontSize="14"
                  FontFamily="{StaticResource UIFont}"
                  SelectionChanged="DropdownBox_SelectionChanged">
        </ComboBox>
    </Grid>
</UserControl>
