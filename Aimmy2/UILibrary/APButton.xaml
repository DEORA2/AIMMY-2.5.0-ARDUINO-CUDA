<UserControl x:Class="Whales2.UILibrary.APButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Whales2.UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="46">
    <Grid Height="46">
        <Border Style="{StaticResource UI.RowHighlight}" />
        <Rectangle Style="{StaticResource UI.RowAccent}" />

        <Label x:Name="ButtonTitle"
               Style="{StaticResource UI.RowLabel}"
               Content="Save Config"
               Margin="0,0,44,0" />

        <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="&#xE76C;"
                   Foreground="{DynamicResource ThemeColor}"
                   FontSize="12"
                   Margin="0,0,20,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />

        <Button x:Name="Reader"
                Style="{StaticResource UI.RowReader}" />
    </Grid>
</UserControl>
