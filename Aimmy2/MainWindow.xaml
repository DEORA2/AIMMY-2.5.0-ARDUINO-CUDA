<Window x:Class="Whales2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Whales2.Controls"
        xmlns:theme="clr-namespace:Whales2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        mc:Ignorable="d"
        Title="WOIRBGOWIBGW"
        Height="860"
        MinHeight="600"
        Width="1180"
        MinWidth="1060"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Theme colors that can be updated dynamically -->
        <SolidColorBrush x:Key="ThemeColor" Color="#FFD7264B"/>
        <SolidColorBrush x:Key="ThemeColorDark" Color="#FFA11C38"/>
        <SolidColorBrush x:Key="ThemeColorLight" Color="#FFE2526F"/>
        <SolidColorBrush x:Key="ThemeGradientDark" Color="#FF400B16"/>

        <!-- Additional theme variations -->
        <SolidColorBrush x:Key="ThemeColorTransparent" Color="#33D7264B"/>
        <SolidColorBrush x:Key="ThemeColorSemiTransparent" Color="#66D7264B"/>

        <Style x:Key="CornerBracket" TargetType="{x:Type Path}">
            <Setter Property="Stroke" Value="{DynamicResource ThemeColor}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Data" Value="M1.5,30 L1.5,1.5 L30,1.5" />
        </Style>

        <Style x:Key="StatusChipBox" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1EFFFFFF" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusChipLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
        <Style x:Key="StatusChipValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource UI.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FooterHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource UI.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,22,0" />
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="4"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="MainBorder"
                Margin="12"
                BorderBrush="#1AFFFFFF"
                BorderThickness="1"
                MouseMove="Main_Background_Gradient">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5"
                                            CenterX="0.5" />
                            <SkewTransform CenterX="0.5"
                                           CenterY="0.5" />
                            <RotateTransform x:Name="RotaryGradient"
                                             Angle="0"
                                             CenterX="0.5"
                                             CenterY="0.5" />
                            <TranslateTransform />
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF0B090B"
                                  Offset="0" />
                    <GradientStop Color="#FF130F12"
                                  Offset="0.55" />
                    <GradientStop x:Name="GradientThemeStop"
                                  Color="#FF400B16"
                                  Offset="1.6" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!--#region Header -->
                <Grid x:Name="Topbar" Margin="30,0,18,0">
                    <Border Width="60"
                            Height="60"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ThemeColorTransparent}"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="1">
                        <Path x:Name="WhalesLogo"
                              Fill="White"
                              Stretch="Fill"
                              Width="28"
                              Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.Data>
                                <PathGeometry Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                              FillRule="NonZero" />
                            </Path.Data>
                        </Path>
                    </Border>

                    <StackPanel Margin="82,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource UIFont}"
                                   FontSize="30"
                                   FontWeight="SemiBold">
                            <Run Text="WHALES" Foreground="{StaticResource UI.Text}" />
                            <Run Text="ENGINE" Foreground="{DynamicResource ThemeColor}" />
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource UIFont}"
                                   FontSize="13"
                                   Margin="1,2,0,0"
                                   Foreground="{StaticResource UI.TextDim}"
                                   Text="AI AIM ASSIST  /  CUDA" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Live status chips: inference rate, execution provider, config, model + aim state -->
                        <Border Style="{StaticResource StatusChipBox}" ToolTip="Inference frames per second (0 while idle)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatusChipLabel}" Text="FPS" />
                                <TextBlock x:Name="FpsText" Style="{StaticResource StatusChipValue}" MinWidth="26" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusChipBox}" ToolTip="ONNX execution provider used by the loaded model">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatusChipLabel}" Text="ENGINE" />
                                <TextBlock x:Name="ProviderText" Style="{StaticResource StatusChipValue}" Text="N/A" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PortChip"
                                Background="{DynamicResource ThemeColorTransparent}"
                                BorderBrush="{DynamicResource ThemeColor}"
                                BorderThickness="1"
                                Height="30"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="PortChip_Click"
                                ToolTip="Click to connect to an Arduino COM port">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="PortDot"
                                           Width="8"
                                           Height="8"
                                           Fill="{StaticResource UI.TextDim}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource StatusChipLabel}" Text="PORT" />
                                <TextBlock x:Name="PortChipValue"
                                           Style="{StaticResource StatusChipValue}"
                                           MinWidth="90"
                                           Text="CLICK TO CONNECT" />
                                <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                      Fill="{StaticResource UI.TextDim}"
                                      VerticalAlignment="Center"
                                      Margin="8,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Popup x:Name="PortPopup"
                               PlacementTarget="{Binding ElementName=PortChip}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#F0110D10"
                                    BorderBrush="{DynamicResource ThemeColor}"
                                    BorderThickness="1"
                                    Padding="14,10"
                                    MinWidth="200">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource UIFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource UI.TextDim}"
                                               Margin="0,0,0,6"
                                               Text="SELECT A COM PORT TO CONNECT" />
                                    <TextBlock x:Name="COMPortsTextBlock"
                                               FontFamily="{StaticResource UIFont}"
                                               FontSize="14"
                                               Foreground="{StaticResource UI.Text}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Border Style="{StaticResource StatusChipBox}" ToolTip="Currently loaded config">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatusChipLabel}" Text="CONFIG" />
                                <TextBlock x:Name="ConfigText" Style="{StaticResource StatusChipValue}" MaxWidth="150" Text="DEFAULT" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="StatusChip" Style="{StaticResource StatusChipBox}" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="StatusDot"
                                           Width="8"
                                           Height="8"
                                           Fill="{StaticResource UI.TextDim}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText"
                                           Style="{StaticResource StatusChipValue}"
                                           Margin="8,0,0,0"
                                           MaxWidth="220"
                                           Text="NO MODEL" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="Minimize"
                                Style="{StaticResource UI.CaptionButton}"
                                Content="&#xE921;"
                                Click="Minimize_Click" />
                        <Button x:Name="Exit"
                                Style="{StaticResource UI.CaptionButton}"
                                Content="&#xE8BB;"
                                Click="Exit_Click" />
                    </StackPanel>
                </Grid>
                <!--#endregion-->

                <Rectangle Grid.Row="1" Fill="{DynamicResource ThemeColor}" />

                <!--#region Tab bar -->
                <Grid x:Name="Sidebar" Grid.Row="2" Margin="30,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PrevTabB"
                            Style="{StaticResource UI.TabButton}"
                            Padding="0"
                            ToolTip="Previous tab (Q)"
                            Click="PrevTab_Click">
                        <Border Style="{StaticResource UI.KeyCap}">
                            <TextBlock Style="{StaticResource UI.KeyCapText}" Text="Q" />
                        </Border>
                    </Button>

                    <UniformGrid x:Name="TabStrip" Grid.Column="1" Rows="1">
                        <Button x:Name="Menu1B" Tag="AimMenu" Style="{StaticResource UI.TabButton}" Content="AIM" Click="MenuSwitch" />
                        <Button x:Name="Menu2B" Tag="ModelMenu" Style="{StaticResource UI.TabButton}" Content="MODELS" Click="MenuSwitch" />
                        <Button x:Name="Menu3B" Tag="SettingsMenu" Style="{StaticResource UI.TabButton}" Content="SETTINGS" Click="MenuSwitch" />
                        <Button x:Name="Menu4B" Tag="AboutMenu" Style="{StaticResource UI.TabButton}" Content="ABOUT" Click="MenuSwitch" />
                    </UniformGrid>

                    <!-- Sliding underline under the active tab -->
                    <Canvas x:Name="TabIndicatorCanvas"
                            Grid.Column="1"
                            IsHitTestVisible="False"
                            ClipToBounds="False">
                        <Border x:Name="MenuHighlighter"
                                Canvas.Bottom="8"
                                Height="3"
                                Width="0"
                                Background="{DynamicResource ThemeColor}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MenuHighlighterOffset" />
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <Button x:Name="NextTabB"
                            Grid.Column="2"
                            Style="{StaticResource UI.TabButton}"
                            Padding="0"
                            ToolTip="Next tab (E)"
                            Click="NextTab_Click">
                        <Border Style="{StaticResource UI.KeyCap}">
                            <TextBlock Style="{StaticResource UI.KeyCapText}" Text="E" />
                        </Border>
                    </Button>
                </Grid>
                <!--#endregion-->

                <!--#region Body: option list + detail panel -->
                <Grid Grid.Row="3" Margin="30,2,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#B80C0A0C" />
                    <Border Background="{StaticResource UI.Hatch}" IsHitTestVisible="False" />
                    <Grid x:Name="ContentArea"
                          Margin="0,8,0,8"
                          PreviewMouseMove="ContentArea_PreviewMouseMove"
                          PreviewMouseUp="ContentArea_StateMayHaveChanged"
                          PreviewKeyUp="ContentArea_StateMayHaveChanged">
                        <!-- UserControls will be loaded here dynamically -->
                    </Grid>

                    <!-- Detail panel: describes the selected option -->
                    <Border Grid.Column="2"
                            Background="#CC110D10"
                            BorderBrush="{DynamicResource ThemeColor}"
                            BorderThickness="0,2,0,0"
                            Padding="26,22,26,22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DetailTitle"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource UI.Text}"
                                       TextWrapping="Wrap"
                                       Text="Aim" />

                            <Border x:Name="DetailBadge"
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    MinWidth="180"
                                    Height="50"
                                    Margin="0,22,0,0"
                                    Padding="20,0"
                                    Background="{DynamicResource ThemeColor}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DetailBadgeText"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="230"
                                           Text="ENABLED" />
                            </Border>

                            <TextBlock x:Name="DetailDescription"
                                       Grid.Row="2"
                                       Margin="0,22,0,0"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="15"
                                       LineHeight="22"
                                       Foreground="#B8ADB1"
                                       TextWrapping="Wrap"
                                       Text="Hover an option to see what it does." />

                            <TextBlock x:Name="DetailHint"
                                       Grid.Row="4"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource UI.TextDim}"
                                       TextWrapping="Wrap"
                                       Text="Use Q / E to switch tabs." />
                        </Grid>
                    </Border>
                </Grid>
                <!--#endregion-->

                <!--#region Footer -->
                <DockPanel Grid.Row="4" Margin="30,0,30,0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Style="{StaticResource UI.KeyCap}">
                            <TextBlock Style="{StaticResource UI.KeyCapText}" Text="LMB" />
                        </Border>
                        <TextBlock Style="{StaticResource FooterHint}" Text="SELECT" />
                        <Border Style="{StaticResource UI.KeyCap}">
                            <TextBlock Style="{StaticResource UI.KeyCapText}" Text="Q" />
                        </Border>
                        <Border Style="{StaticResource UI.KeyCap}" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource UI.KeyCapText}" Text="E" />
                        </Border>
                        <TextBlock Style="{StaticResource FooterHint}" Text="TABS" />
                    </StackPanel>

                    <TextBlock x:Name="ItemCounter"
                               DockPanel.Dock="Right"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="14"
                               Foreground="{StaticResource UI.TextDim}"
                               VerticalAlignment="Center"
                               Text="0 / 0" />
                </DockPanel>
                <!--#endregion-->
            </Grid>
        </Border>

        <!-- Corner brackets framing the window -->
        <Path Style="{StaticResource CornerBracket}" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Path Style="{StaticResource CornerBracket}" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
        </Path>
        <Path Style="{StaticResource CornerBracket}" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
        </Path>
        <Path Style="{StaticResource CornerBracket}" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
        </Path>
    </Grid>
</Window>
